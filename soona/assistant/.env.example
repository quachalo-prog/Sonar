# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
# Modèle principal de l'assistant
CLAUDE_MODEL=claude-opus-5-5
# Profondeur de réflexion : low convient bien au chat (low | medium | high | xhigh | max)
CLAUDE_EFFORT=low

# --- Embeddings (Voyage AI, partenaire recommandé par Anthropic) ---
VOYAGE_API_KEY=pa-...
VOYAGE_MODEL=voyage-3.5
# Doit correspondre à la colonne vector(1024) de la migration SQL
EMBEDDING_DIM=1024

# --- Supabase (pgvector) : clé service_role, côté serveur uniquement, jamais dans le front ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Mémoire / RGPD ---
MEMORY_TOP_K=6
MEMORY_MIN_SIMILARITY=0.75
MEMORY_RETENTION_DAYS=180
# Détection des noms par Claude en plus des règles locales (envoie le texte au LLM)
PII_LLM_DETECTION=false

# --- Serveur ---
PORT=8787
ALLOWED_ORIGIN=https://soona.example.fr
