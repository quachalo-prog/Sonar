{
  "name": "soona-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "Assistant Soona : mémoire vectorielle, boucle de feedback et anonymisation RGPD (Claude + Supabase pgvector)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "export-dataset": "tsx scripts/export-dataset.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@supabase/supabase-js": "^2.117.3",
    "express": "^5.3.0",
    "voyageai": "^0.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
